# Copy to .env and adjust (or export these in your shell).

# --- Payments ---------------------------------------------------------------
X402_ENABLED=true
FACILITATOR=mock                 # mock (dev) | coinbase (real on-chain)
NETWORK=base-sepolia             # base-sepolia (testnet) | base (mainnet)

# Your wallet — where payments land. REQUIRED before taking real money.
RECEIVING_WALLET=0x0000000000000000000000000000000000000000

# USDC contract for your NETWORK (defaults to base-sepolia testnet USDC).
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Facilitator that verifies/settles payments (confirm current URL at x402.org).
FACILITATOR_URL=https://x402.org/facilitator

# --- Pricing (atomic USDC units; 1_000_000 = 1 USDC) ------------------------
PRICE_STORE=500                  # 0.0005 USDC per write
PRICE_SEARCH=1000                # 0.001  USDC per search
PRICE_RETRIEVE=200               # 0.0002 USDC per fetch

# --- Embeddings -------------------------------------------------------------
EMBEDDINGS_PROVIDER=sentence-transformers   # sentence-transformers | hashing | openai
EMBEDDINGS_MODEL=all-MiniLM-L6-v2
# OPENAI_API_KEY=sk-...          # only if EMBEDDINGS_PROVIDER=openai

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8402

# --- Dashboard access ------------------------------------------------------
# Required once the server is publicly reachable (HOST=0.0.0.0). Without it the
# dashboard refuses to render rather than exposing revenue + customer data.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Hardening (defaults are sensible; tune when real traffic arrives) ------
RATE_LIMIT_PER_MIN=60            # calls/min per client; 0 disables
MAX_TEXT_BYTES=8192              # max size of one stored memory
MAX_QUERY_BYTES=1024             # max search query size
MAX_METADATA_BYTES=2048          # max serialized metadata size
MAX_TOP_K=20                     # max results per search
MAX_MEMORIES_PER_AGENT=10000     # storage quota per agent
MAX_BODY_BYTES=65536             # max raw HTTP request body
